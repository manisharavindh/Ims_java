<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.ReportController" spacing="10" style="-fx-padding: 15;">
    
    <Label text="Reports" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    
    <ToolBar styleClass="tool-bar" style="-fx-background-color: #E8E8E8; -fx-border-width: 0;">
        <Button text="All Books" onAction="#showAllBooks" />
        <Button text="Available Books" onAction="#showAvailableBooks" />
        <Button text="Issued Books" onAction="#showIssuedBooks" />
        <Button text="Overdue Books" onAction="#showOverdueBooks" />
        <Button text="All Members" onAction="#showAllMembers" />
        <Button text="Borrowing History" onAction="#showBorrowingHistory" />
    </ToolBar>
    
    <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="table-view" />

</VBox>
