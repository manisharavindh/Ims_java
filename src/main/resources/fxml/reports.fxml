<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.ReportController">
    <left>
        <fx:include source="sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="15" style="-fx-padding: 30;">
            <Label text="Reports" styleClass="page-title" />
            
            <HBox spacing="10">
                <Button text="All Books" onAction="#showAllBooks" styleClass="btn-secondary" />
                <Button text="Available Books" onAction="#showAvailableBooks" styleClass="btn-secondary" />
                <Button text="Issued Books" onAction="#showIssuedBooks" styleClass="btn-secondary" />
                <Button text="Overdue Books" onAction="#showOverdueBooks" styleClass="btn-secondary" />
                <Button text="All Members" onAction="#showAllMembers" styleClass="btn-secondary" />
            </HBox>
            
            <Label text="Borrowing History (Temporary View):" style="-fx-font-weight: bold;" />
            <TableView fx:id="reportTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn text="Tx ID" prefWidth="50">
                        <cellValueFactory><PropertyValueFactory property="transactionId" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Book ID" prefWidth="60">
                        <cellValueFactory><PropertyValueFactory property="bookId" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Member ID" prefWidth="70">
                        <cellValueFactory><PropertyValueFactory property="memberId" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Issue Date" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="issueDate" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Due Date" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="dueDate" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Return Date" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="returnDate" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Status" prefWidth="100">
                        <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
