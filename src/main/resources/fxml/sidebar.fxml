<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.SidebarController" styleClass="sidebar">
    <Label text="LMS Admin" styleClass="sidebar-title" />
    <Button text="Dashboard" onAction="#goDashboard" styleClass="sidebar-btn" />
    <Button text="Books" onAction="#goBooks" styleClass="sidebar-btn" />
    <Button text="Members" onAction="#goMembers" styleClass="sidebar-btn" />
    <Button text="Issue Book" onAction="#goIssueBook" styleClass="sidebar-btn" />
    <Button text="Return Book" onAction="#goReturnBook" styleClass="sidebar-btn" />
    <Button text="Reports" onAction="#goReports" styleClass="sidebar-btn" />
    
    <Region VBox.vgrow="ALWAYS" />
    
    <Button text="Logout" onAction="#logout" styleClass="sidebar-btn" style="-fx-text-fill: #ef233c;" />
</VBox>
