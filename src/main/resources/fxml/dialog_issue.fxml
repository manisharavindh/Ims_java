<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.TransactionController" spacing="15" style="-fx-padding: 20; -fx-background-color: #E8E8E8;">
    
    <GridPane hgap="10" vgap="10">
        <Label text="Member:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="memberComboBox" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <Label text="Book:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="bookComboBox" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        
        <Label text="Issue Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <DatePicker fx:id="issueDatePicker" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        
        <Label text="Due Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <DatePicker fx:id="dueDatePicker" prefWidth="150" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Issue" onAction="#handleIssueBook" defaultButton="true" prefWidth="80" />
        <Button text="Cancel" onAction="#handleCancelIssue" cancelButton="true" prefWidth="80" />
    </HBox>
    
</VBox>
