<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.DashboardController">
    <left>
        <fx:include source="sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <Label text="Dashboard" styleClass="page-title" />
            
            <HBox spacing="20">
                <!-- Total Books Card -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="Total Books" styleClass="card-title" />
                    <Label fx:id="totalBooksLabel" text="0" styleClass="card-value" />
                </VBox>
                
                <!-- Available Books Card -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="Available Books" styleClass="card-title" />
                    <Label fx:id="availableBooksLabel" text="0" styleClass="card-value" />
                </VBox>
                
                <!-- Issued Books Card -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="Issued Books" styleClass="card-title" />
                    <Label fx:id="issuedBooksLabel" text="0" styleClass="card-value" />
                </VBox>
                
                <!-- Total Members Card -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="Total Members" styleClass="card-title" />
                    <Label fx:id="totalMembersLabel" text="0" styleClass="card-value" />
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
