<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.DashboardController" spacing="20" style="-fx-padding: 15; -fx-background-color: #E8E8E8;">
    
    <Label text="Overview" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    
    <HBox spacing="20">
        <VBox styleClass="card" alignment="CENTER" prefWidth="180" prefHeight="90">
            <Label text="Total Books" style="-fx-text-fill: #666666; -fx-font-size: 13px;"/>
            <Label fx:id="totalBooksLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
        </VBox>
        <VBox styleClass="card" alignment="CENTER" prefWidth="180" prefHeight="90">
            <Label text="Available Books" style="-fx-text-fill: #666666; -fx-font-size: 13px;"/>
            <Label fx:id="availableBooksLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
        </VBox>
        <VBox styleClass="card" alignment="CENTER" prefWidth="180" prefHeight="90">
            <Label text="Issued Books" style="-fx-text-fill: #666666; -fx-font-size: 13px;"/>
            <Label fx:id="issuedBooksLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
        </VBox>
        <VBox styleClass="card" alignment="CENTER" prefWidth="180" prefHeight="90">
            <Label text="Total Members" style="-fx-text-fill: #666666; -fx-font-size: 13px;"/>
            <Label fx:id="totalMembersLabel" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
        </VBox>
    </HBox>
    
    <Label text="Recent Transactions" style="-fx-font-weight: bold;"/>
    
    <TableView fx:id="recentTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn text="Tx ID" prefWidth="50" />
            <TableColumn text="Book ID" prefWidth="60" />
            <TableColumn text="Member ID" prefWidth="70" />
            <TableColumn text="Issue Date" prefWidth="120" />
            <TableColumn text="Due Date" prefWidth="120" />
            <TableColumn text="Status" prefWidth="100" />
        </columns>
    </TableView>
</VBox>
