<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.BookController" spacing="10" style="-fx-padding: 15;">
    
    <Label text="Books" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Search:" />
        <TextField fx:id="searchField" promptText="Title, Author, ISBN..." prefWidth="250" />
        <Button text="Search" onAction="#handleSearch" />
        <Button text="Refresh" onAction="#handleRefresh" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Add Book" onAction="#handleAdd" />
        <Button text="Edit Book" onAction="#handleEdit" />
        <Button text="Delete Book" onAction="#handleDelete" />
    </HBox>
    
    <TableView fx:id="bookTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn text="ID" prefWidth="50" />
            <TableColumn text="Title" prefWidth="250" />
            <TableColumn text="Author" prefWidth="180" />
            <TableColumn text="Category" prefWidth="120" />
            <TableColumn text="ISBN" prefWidth="120" />
            <TableColumn text="Total" prefWidth="70" />
            <TableColumn text="Available" prefWidth="70" />
        </columns>
    </TableView>
</VBox>
