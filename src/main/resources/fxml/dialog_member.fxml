<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.MemberDialogController" spacing="15" style="-fx-padding: 20; -fx-background-color: #E8E8E8;">
    
    <GridPane hgap="10" vgap="10">
        <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="nameField" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        
        <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        
        <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        
        <Label text="Department:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="deptField" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    </GridPane>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Save" onAction="#handleSave" defaultButton="true" prefWidth="80" />
        <Button text="Cancel" onAction="#handleCancel" cancelButton="true" prefWidth="80" />
    </HBox>
    
</VBox>
