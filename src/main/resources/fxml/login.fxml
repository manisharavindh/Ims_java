<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.LoginController" style="-fx-background-color: #CCCCCC;">

    <VBox spacing="20" alignment="CENTER" style="-fx-background-color: #EEEEEE; -fx-border-color: #888888; -fx-border-width: 2; -fx-padding: 40; -fx-max-width: 350; -fx-max-height: 280;">
        
        <!-- Header -->
        <VBox alignment="CENTER" spacing="5">
            <Label text="LMS Login" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="Please enter your credentials." style="-fx-font-size: 12px;"/>
        </VBox>
        
        <!-- Input Fields -->
        <GridPane hgap="10" vgap="15" alignment="CENTER">
            <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="180" />
            
            <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        </GridPane>
        
        <!-- Actions -->
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button text="Login" onAction="#handleLogin" defaultButton="true" prefWidth="80"/>
        </HBox>
        
    </VBox>
    
</StackPane>
