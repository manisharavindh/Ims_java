<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.LoginController" style="-fx-background-color: #2b2d42;">
    <VBox alignment="CENTER" maxWidth="400" maxHeight="350" styleClass="login-box">
        
        <Label text="Library Management System" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2b2d42;" />
        
        <Label text="Login to your account" style="-fx-text-fill: #8d99ae; -fx-padding: 0 0 10 0;" />
        
        <Label fx:id="errorLabel" style="-fx-text-fill: red;" />
        
        <TextField fx:id="usernameField" promptText="Username" styleClass="text-field" />
        
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="password-field" />
        
        <Button text="LOGIN" onAction="#handleLogin" styleClass="btn-primary" prefWidth="400" />
        
    </VBox>
</StackPane>
