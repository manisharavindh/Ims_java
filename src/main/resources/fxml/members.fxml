<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.MemberController" orientation="VERTICAL" dividerPositions="0.7">
    
    <VBox spacing="10" style="-fx-padding: 10;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Search:" />
            <TextField fx:id="searchField" promptText="Search Members..." prefWidth="250" />
            <Button text="Search" onAction="#handleSearch" />
            <Button text="Refresh" onAction="#handleRefresh" />
        </HBox>
        
        <TableView fx:id="memberTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn text="ID" prefWidth="50" />
                <TableColumn text="Name" prefWidth="200" />
                <TableColumn text="Email" prefWidth="220" />
                <TableColumn text="Phone" prefWidth="150" />
                <TableColumn text="Department" prefWidth="180" />
            </columns>
        </TableView>
    </VBox>
    
    <VBox spacing="10" style="-fx-padding: 10; -fx-background-color: #E8E8E8;">
        <Label text="Member Details (Select a row to edit or clear to add new)" style="-fx-font-weight: bold;"/>
        <GridPane hgap="15" vgap="10">
            <Label text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250"/>
            
            <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="emailField" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="250"/>
            
            <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Department:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="deptField" GridPane.columnIndex="3" GridPane.rowIndex="1" />
        </GridPane>
        
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
            <Button text="Save / Add" onAction="#handleSave" styleClass="button" defaultButton="true"/>
            <Button text="Delete Selected" onAction="#handleDelete" styleClass="button"/>
            <Button text="Clear Form" onAction="#clearForm" styleClass="button"/>
        </HBox>
    </VBox>
    
</SplitPane>
