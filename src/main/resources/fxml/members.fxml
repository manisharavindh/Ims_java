<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.lms.controller.MemberController">
    <left>
        <fx:include source="sidebar.fxml" />
    </left>
    <center>
        <VBox spacing="15" style="-fx-padding: 30;">
            <Label text="Member Management" styleClass="page-title" />
            
            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="Search members..." prefWidth="250" styleClass="text-field" />
                <Button text="Search" onAction="#handleSearch" styleClass="btn-secondary" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary" />
            </HBox>
            
            <TableView fx:id="memberTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn text="ID" prefWidth="50">
                        <cellValueFactory><PropertyValueFactory property="memberId" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Name" prefWidth="200">
                        <cellValueFactory><PropertyValueFactory property="name" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Email" prefWidth="200">
                        <cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Phone" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="phone" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Department" prefWidth="150">
                        <cellValueFactory><PropertyValueFactory property="department" /></cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            
            <!-- Add/Edit Form Area -->
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #ced4da; -fx-border-radius: 5;">
                <Label text="Add / Edit Member" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                <HBox spacing="10">
                    <TextField fx:id="nameField" promptText="Full Name" HBox.hgrow="ALWAYS" />
                    <TextField fx:id="emailField" promptText="Email" HBox.hgrow="ALWAYS" />
                </HBox>
                <HBox spacing="10">
                    <TextField fx:id="phoneField" promptText="Phone" />
                    <TextField fx:id="deptField" promptText="Department" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Add" onAction="#handleAdd" styleClass="btn-primary" />
                    <Button text="Edit" onAction="#handleEdit" styleClass="btn-secondary" />
                    <Button text="Delete" onAction="#handleDelete" styleClass="btn-secondary" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
